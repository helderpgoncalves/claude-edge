<?xml version="1.0" encoding="utf-8"?>
<!--
  Application properties and their user-facing settings.

  These are edited in Garmin Connect Mobile (or Garmin Express), not on the
  device: typing a URL and a 43-character token on a bike computer with seven
  buttons is not a real option. The device reads them via
  Application.Properties and reacts to changes in onSettingsChanged().

  Note the token uses type="password" so it is masked in the phone UI and not
  shown in plain text on a screen someone else may be looking at.
-->
<resources>
    <properties>
        <!-- Bridge server. Must be HTTPS with a publicly trusted certificate:
             Connect IQ rejects plain HTTP and self-signed chains outright. -->
        <property id="serverUrl" type="string"></property>
        <property id="authToken" type="string"></property>

        <!-- Empty means "whatever the server's default session is", which is
             the common case for a single-developer deployment. -->
        <property id="sessionName" type="string"></property>

        <!-- 0 adaptive, 1 always fast, 2 battery saver, 3 custom.
             Adaptive lets the server choose per state, which is why it is the
             default: the bridge knows whether Claude is mid-task or idle. -->
        <property id="pollMode" type="number">0</property>
        <property id="pollSeconds" type="number">5</property>

        <!-- 0 xtiny, 1 tiny, 2 small. Smaller text fits more of the terminal. -->
        <property id="fontSize" type="number">0</property>

        <!-- Require a second press before sending anything flagged risky. -->
        <property id="confirmDestructive" type="boolean">true</property>

        <!-- Vibrate when the session starts waiting on a human. -->
        <property id="vibrateOnPrompt" type="boolean">true</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.serverUrl" title="@Strings.SettingsServerUrl">
            <settingConfig type="alphaNumeric" required="true" maxLength="200" />
        </setting>

        <setting propertyKey="@Properties.authToken" title="@Strings.SettingsToken">
            <settingConfig type="password" required="true" maxLength="200" />
        </setting>

        <setting propertyKey="@Properties.sessionName" title="@Strings.SettingsSession">
            <settingConfig type="alphaNumeric" maxLength="64" />
        </setting>

        <setting propertyKey="@Properties.pollMode" title="@Strings.SettingsPollMode">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingsPollAdaptive</listEntry>
                <listEntry value="1">@Strings.SettingsPollFast</listEntry>
                <listEntry value="2">@Strings.SettingsPollSlow</listEntry>
                <listEntry value="3">@Strings.SettingsPollCustom</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.pollSeconds" title="@Strings.SettingsPollSeconds">
            <settingConfig type="numeric" min="2" max="300" />
        </setting>

        <setting propertyKey="@Properties.fontSize" title="@Strings.SettingsFontSize">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SettingsFontXTiny</listEntry>
                <listEntry value="1">@Strings.SettingsFontTiny</listEntry>
                <listEntry value="2">@Strings.SettingsFontSmall</listEntry>
            </settingConfig>
        </setting>

        <setting
            propertyKey="@Properties.confirmDestructive"
            title="@Strings.SettingsConfirmDestructive">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.vibrateOnPrompt" title="@Strings.SettingsVibrate">
            <settingConfig type="boolean" />
        </setting>
    </settings>
</resources>
