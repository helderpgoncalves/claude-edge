{
  "name": "claude-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor and control a Claude Code session from a Garmin Edge cycling computer",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --filter @claude-edge/shared build && pnpm --filter @claude-edge/server build",
    "dev": "pnpm --filter @claude-edge/server dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  },
  "license": "MIT"
}
