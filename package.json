{
  "name": "claude-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor and control a Claude Code session from a Garmin Edge cycling computer",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm --filter @claude-edge/shared build && pnpm --filter @claude-edge/server build",
    "dev": "pnpm --filter @claude-edge/server dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "sharp@<0.35.5": "^0.35.5",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "fast-copy@<4.1.0": "^4.1.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "fast-uri@>=3 <3.1.9": "^3.1.9",
      "fast-uri@>=4 <4.2.3": "^4.2.3"
    }
  }
}
