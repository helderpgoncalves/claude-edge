# Bridge configuration.
#
#   cp .env.example .env
#
# The server validates all of this at startup and refuses to boot on anything
# invalid, rather than warning and continuing. A bridge that starts with
# authentication accidentally disabled is worse than one that does not start:
# you would believe it was protected.

# ---------------------------------------------------------------------------
# Authentication  (required)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_'
#
# Two tokens, deliberately. READ_TOKEN can only read state; WRITE_TOKEN can
# type into the session. Put the read token on any device you might lose.
#
# If READ_TOKEN is unset the server generates one and prints it once, on
# stderr, so it is not captured by a log shipper.
READ_TOKEN=
WRITE_TOKEN=

# ---------------------------------------------------------------------------
# tmux
# ---------------------------------------------------------------------------
# The session Claude Code runs in.
TMUX_SESSION=claude

# Socket name. Running Claude Code on a dedicated socket:
#
#     tmux -L claude-edge new-session -s claude
#
# makes the bridge structurally unable to reach your other tmux sessions,
# whatever the code does. This is the cheapest and strongest control available
# here — see docs/security.md. Leave empty to use the default socket.
TMUX_SOCKET=claude-edge

# Comma-separated extra sessions the bridge may address. Empty means only
# TMUX_SESSION. A session outside this list is indistinguishable from one that
# does not exist, so the response leaks nothing about what else is running.
ALLOWED_SESSIONS=

# Host directory holding the tmux socket, bind-mounted into the container.
# Find it with:  echo ${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)
TMUX_SOCKET_DIR=/tmp/tmux-1000

# ---------------------------------------------------------------------------
# Capabilities  (both off by default, on purpose)
# ---------------------------------------------------------------------------
# Free text into a running agent is arbitrary instruction to a system with file
# and shell access. Enable only if you want the phone to send prompts.
ALLOW_FREE_TEXT=false

# Destructive actions: Ctrl-C, and any option matching "don't ask again".
# The second is the consequential one — accepting it widens the agent's
# permissions for the rest of the session. Not a decision to make one-handed
# on a bicycle, which is why it is refused unless you turn it on here.
ALLOW_DESTRUCTIVE=false

# ---------------------------------------------------------------------------
# Adaptive polling  (seconds)
# ---------------------------------------------------------------------------
# The server tells the device when to come back, so battery policy lives here
# and can be retuned without reflashing anyone's Edge. The device clamps what
# it is given to 2..300.
POLL_WORKING_S=3
POLL_BLOCKED_S=2
POLL_IDLE_S=15
POLL_DEAD_S=30

# ---------------------------------------------------------------------------
# Rate limits  (per token, per minute)
# ---------------------------------------------------------------------------
# Keyed on the credential rather than the IP: every request arrives via the
# phone and shares NAT with strangers, so an IP is neither stable nor
# meaningful. This bounds what one leaked token can do.
RATE_READ_PER_MIN=60
RATE_WRITE_PER_MIN=20

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787

# Loopback by default. The intended deployment puts a TLS-terminating proxy in
# front, or a private network around, this process. Binding 0.0.0.0 should be
# a deliberate act.
HOST=127.0.0.1

LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------------------
# Production only  (docker/compose.yaml)
# ---------------------------------------------------------------------------
# The domain the certificate is issued for, and the address the Edge is
# configured with. Connect IQ requires HTTPS with a publicly trusted
# certificate; plain HTTP and self-signed chains fail with
# SECURE_CONNECTION_REQUIRED (-1001).
DOMAIN=claude.example.com

# Let's Encrypt uses this to warn about expiry problems.
ACME_EMAIL=you@example.com
